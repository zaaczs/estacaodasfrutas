generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // ADMIN | ATTENDANT | CUSTOMER
  createdAt DateTime @default(now())

  deliveryLists DeliveryList[]
}

model Product {
  id           String           @id @default(uuid())
  name         String
  description  String?
  imageUrl     String?
  complements  String?
  category     String
  unit         String
  price        Float
  cost         Float
  stock        Float
  minStock     Float
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())

  orderItems   OrderItem[]
  stockMovements StockMovement[]
}

model ProductCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id         String   @id @default(uuid())
  name       String
  phone      String
  cpfCnpj    String?
  address    String?
  complement String?
  createdAt  DateTime @default(now())

  orders    Order[]
}

model Order {
  id             String   @id @default(uuid())
  customerId     String?
  customerUserId String?
  total          Float
  status         String   // OPEN | FINISHED | CANCELED
  paymentMethod  String?
  paymentCategory String  @default("NORMAL") // NORMAL | FIADO
  paymentStatus  String   @default("PAID") // PENDING | PAID
  paidAt         DateTime?
  orderType      String   @default("PICKUP") // DELIVERY | PICKUP
  customerPhoneSnapshot String?
  deliveryAddress String?
  source         String?  // CATALOG | INTERNAL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  items             OrderItem[]
  customer          Customer?          @relation(fields: [customerId], references: [id])
  deliveryListItems DeliveryListItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Float
  price     Float
  notes     String?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model StockMovement {
  id        String   @id @default(uuid())
  productId String
  type      String   // SALE | ENTRY | ADJUSTMENT
  quantity  Float
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

model DeliveryList {
  id          String    @id @default(uuid())
  name        String
  type        String    // DELIVERY | WEDDING | CUSTOM
  status      String    @default("ACTIVE") // ACTIVE | ARCHIVED
  serviceDate DateTime
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  printedAt   DateTime?

  createdBy User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     DeliveryListItem[]

  @@index([serviceDate])
  @@index([status])
}

model DeliveryListItem {
  id       String   @id @default(uuid())
  listId   String
  orderId  String
  position Int
  addedAt  DateTime @default(now())

  list  DeliveryList @relation(fields: [listId], references: [id], onDelete: Cascade)
  order Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([listId, orderId])
  @@index([orderId])
}

model Expense {
  id          String   @id @default(uuid())
  description String
  category    String?
  amount      Float
  date        DateTime
  createdAt   DateTime @default(now())
}

/// Imagem enviada no cadastro do produto. Fica no banco porque o disco do Heroku é efêmero
/// e o Next em produção não serve arquivos criados em public/ depois do start.
model ProductImage {
  id        String   @id @default(uuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}
