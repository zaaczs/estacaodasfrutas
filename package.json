{
  "name": "estacao-das-frutas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "node scripts/prepareHerokuDatabase.js && prisma generate",
    "dev": "next dev -p 3001",
    "dev:clean": "node scripts/clean-next.cjs && next dev -p 3001",
    "db:sync": "prisma generate && prisma db push",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "import:products": "tsx scripts/importProducts.ts",
    "import:products:ts-node": "ts-node -P tsconfig.scripts.json scripts/importProducts.ts",
    "recategorize:products": "tsx scripts/recategorizeProducts.ts",
    "fix:product-accents": "tsx scripts/fixProductAccents.ts --apply",
    "seed:test-products": "tsx scripts/seedProductTestData.ts",
    "clear:product-images": "tsx scripts/clearProductImages.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "14.2.15",
    "next-auth": "^4.24.10",
    "prisma": "^5.22.0",
    "qz-tray": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tsx": "^4.19.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
